# Copy to .env (git-ignored). Never commit real values.

# --- run mode ---------------------------------------------------------------
DEMO=1                 # 1 = replay canned domains (offline); 0 = live Certificate Transparency stream
THRESHOLD=40           # minimum lookalike score to flag a domain

# --- API security -----------------------------------------------------------
# Bearer token for every data endpoint. 24+ chars. If unset, a random one is generated and printed at startup.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
ALLOWED_HOSTS=localhost,127.0.0.1     # Host headers accepted (add your domain when deploying)
# ALLOWED_ORIGINS=https://phish.example.com
# ENABLE_DOCS=0

# --- Elasticsearch (leave ELASTIC_URL empty to run fully in memory) --------
# https://<deployment>.es.<region>.elastic.cloud  (https required; http only for localhost)
ELASTIC_URL=
# Encoded API key. Prefer a least-privilege key (see README) over an admin key.
ELASTIC_API_KEY=
# ELASTIC_CA_CERTS=/path/to/ca.pem    # only for self-managed clusters with a private CA
# Enables Agent Builder (tools + agent + converse)
KIBANA_URL=
# KIBANA_API_KEY=      # defaults to ELASTIC_API_KEY
# Enables Jina embeddings + reranker (created as Elasticsearch inference endpoints)
JINA_API_KEY=
# SEMANTIC_SEARCH=1    # defaults to on when JINA_API_KEY is set; use to reuse existing endpoints instead
# JINA_EMBED_INFERENCE_ID=doppel-jina-embed
# JINA_RERANK_INFERENCE_ID=doppel-jina-rerank
# AGENT_ID=doppel-analyst

# --- agent behaviour --------------------------------------------------------
AUTO_INVESTIGATE=1     # investigate high-scoring hits automatically
INVESTIGATE_SCORE=60
TRIAGE_FETCH=0         # 1 = fetch suspect pages (SSRF-hardened) to detect login forms. Off by default.
AUTO_ACTIONS=0         # 1 = let policy run low-risk actions unattended (block_domain, notify). Off by default.
AUTO_SCORE=85          # minimum score for unattended actions (also needs 2+ corroborating signals)
# ACTION_WEBHOOK_URL=https://hooks.slack.com/services/...   # https only
# OUTBOX_DIR=outbox

# --- optional integrations (both are no-ops when unset) --------------------
# Analyst write-up when Kibana Agent Builder isn't configured, or fails. One grounded completion over
# evidence already gathered locally, not a tool-calling loop. Never used if KIBANA_URL is set and working.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Error tracking + light performance tracing for the pipeline, investigator and API. send_default_pii is off.
SENTRY_DSN=
